# Copy to .env.production and replace every example value. Never commit the result.
COMPOSE_PROJECT_NAME=nonna-production
DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com
PUBLIC_BIND_ADDRESS=0.0.0.0
# Keep false only for the first mTLS-protected admin setup. Set true after clearing Public permissions.
ENFORCE_EMPTY_PUBLIC_ROLE=false

# Persistent ACME state and webroot. These paths must exist before bootstrap.
CERTBOT_STATE_DIR=/srv/nonna/certbot/state
CERTBOT_WEBROOT_DIR=/srv/nonna/certbot/webroot
CERTBOT_RENEW_INTERVAL=43200
NGINX_CERT_RELOAD_INTERVAL=3600

# Public certificate of the self-issued CA that signs operator client certificates.
ADMIN_CLIENT_CA_FILE=/etc/nonna/tls/admin-client-ca.crt

# Secret files are mounted with Docker Compose secrets. Each file contains only its value.
APP_KEYS_FILE=/etc/nonna/secrets/app-keys
API_TOKEN_SALT_FILE=/etc/nonna/secrets/api-token-salt
ADMIN_JWT_SECRET_FILE=/etc/nonna/secrets/admin-jwt-secret
TRANSFER_TOKEN_SALT_FILE=/etc/nonna/secrets/transfer-token-salt
JWT_SECRET_FILE=/etc/nonna/secrets/jwt-secret
API_BEARER_TOKEN_FILE=/etc/nonna/secrets/read-only-api-token
