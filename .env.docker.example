# Copy this file to .env before starting Docker Compose.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
CMS_PORT=1337
FRONTEND_PORT=3000

# The source database is copied only when the Docker volume is empty.
CMS_SEED_DATABASE=./cms/.tmp/data.db

# Create a read-only Strapi API token in /admin and put its plain value here.
API_BEARER_TOKEN=
